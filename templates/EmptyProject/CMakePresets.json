{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Base preset - requires MSVC in PATH (use build.ps1 or Developer PowerShell)",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "default",
      "displayName": "Release (Recommended)",
      "description": "Release build with Ninja + MSVC. Use build.ps1 for automatic environment setup.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with Ninja + MSVC. Requires Debug SDK libraries.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Release with Debug Info",
      "description": "Release with debug symbols for profiling.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "description": "Base Clang preset - requires LLVM/Clang installed and in PATH",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release (LLVM required)",
      "description": "Uses clang-cl from LLVM. Install LLVM and add to PATH. No vcvars needed.",
      "inherits": "clang-base",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug (LLVM required)",
      "description": "Debug with Clang. Requires Debug SDK libraries.",
      "inherits": "clang-base",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Build Release",
      "configurePreset": "default",
      "jobs": 8
    },
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "debug",
      "jobs": 8
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Build RelWithDebInfo",
      "configurePreset": "relwithdebinfo",
      "jobs": 8
    },
    {
      "name": "clang-release",
      "displayName": "Build (Clang Release)",
      "configurePreset": "clang-release",
      "jobs": 8
    },
    {
      "name": "clang-debug",
      "displayName": "Build (Clang Debug)",
      "configurePreset": "clang-debug",
      "jobs": 8
    }
  ]
}
